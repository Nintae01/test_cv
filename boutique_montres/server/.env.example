# Copiez ce fichier en « .env » et renseignez vos clés Stripe (tableau de bord Stripe → Développeurs → Clés API).
STRIPE_CLE_SECRETE=sk_test_VOTRE-CLE-SECRETE-ICI
# Secret de signature du webhook (Développeurs → Webhooks), facultatif en développement.
STRIPE_SECRET_WEBHOOK=whsec_VOTRE-SECRET-WEBHOOK-ICI
# Port d'écoute du serveur
PORT=4242
# Origines autorisées (séparées par des virgules) : l'adresse de votre site.
ORIGINES_AUTORISEES=http://localhost:8080,http://127.0.0.1:8080,https://VOTRE-UTILISATEUR.github.io
