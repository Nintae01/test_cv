# ---- required ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- voice (optional; without it she only shows speech bubbles) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- sensors (optional) ----
# LibreHardwareMonitor > Options > Remote Web Server. Needed for CPU temps on Windows.
LHM_URL=http://localhost:8085

# ---- character ----
COMPANION_NAME=Mika
COMPANION_MODEL=claude-opus-5-5
# Served from src/renderer/public, so this is a URL path, not a file path.
# haru-scarlet is produced by scripts/recolor-hair.py from the SDK's Haru sample (see README).
LIVE2D_MODEL_URL=/model/haru-scarlet/Haru.model3.json
