[Unit]
Description=La Roux du Temps - boutique de montres (serveur statique)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
ExecStart=/usr/bin/env python3 -m http.server __PORT__ --bind 0.0.0.0 --directory __ROOT__
Restart=on-failure

[Install]
WantedBy=multi-user.target
